apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: faceless-video-app
type: Opaque
stringData:
  # Get your OpenAI API key from https://platform.openai.com/api-keys
  openai-api-key: "sk-proj-YOUR_OPENAI_API_KEY_HERE"
  # Get your Pexels API key from https://www.pexels.com/api/
  pexels-api-key: "YOUR_PEXELS_API_KEY_HERE"
  # Get your YouTube credentials from https://console.cloud.google.com/
  youtube-client-id: "YOUR_YOUTUBE_CLIENT_ID_HERE"
  youtube-client-secret: "YOUR_YOUTUBE_CLIENT_SECRET_HERE"
  # Get your ElevenLabs API key from https://elevenlabs.io/
  elevenlabs-api-key: "YOUR_ELEVENLABS_API_KEY_HERE"
  # Use a strong, random secret for this
  secret-key: "YOUR_SECRET_KEY_HERE"
